{
  "name": "neet-counselling-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:data": "python scripts/import_counselling_csv_pg.py && python scripts/export_counselling_data_pg.py && python scripts/import_counselling_csv_ug.py && python scripts/export_counselling_data_ug.py",
    "build": "npm run build:data && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:import": "python scripts/import_counselling_csv_pg.py",
    "db:export": "python scripts/export_counselling_data_pg.py",
    "db:refresh": "python scripts/import_counselling_csv_pg.py && python scripts/export_counselling_data_pg.py",
    "db:import:ug": "python scripts/import_counselling_csv_ug.py",
    "db:export:ug": "python scripts/export_counselling_data_ug.py",
    "db:refresh:ug": "python scripts/import_counselling_csv_ug.py && python scripts/export_counselling_data_ug.py"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1"
  }
}
